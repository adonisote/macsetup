# Brewfile - Template Structure


# Search for command-line tools
#brew search package-name

# Search for GUI apps
#brew search --cask app-name

# Search Mac App Store
#mas search "app name"


# ============================================
# TAPS (Third-party repositories)
# ============================================
# Add these if you need special repositories
#tap "homebrew/bundle"           # For brew bundle command


# ============================================
# CLI UTILITIES - Core Tools
# ============================================
brew "wget"                     # Download files from web
brew "tree"                     # Display directory structure as tree
brew "jq"                       # JSON processor
brew "yq"                       # YAML processor
brew "ripgrep"                  # Fast grep alternative (rg)
brew "bat"                      # Better cat with syntax highlighting
brew "eza"                      # Modern ls replacement
brew "fzf"                      # Fuzzy finder for command line
brew "tldr"                     # Simplified man pages
brew "btop"                     # Modern, beautiful process monitor
brew "mas"                      # Mac App Store CLI


# ============================================
# DEVELOPMENT TOOLS
# ============================================
brew "gh"                       # GitHub CLI
brew "neovim"                   # Modern Vim editor
brew "starship"                 # Cross-shell prompt for astronauts



# ============================================
# VERSION MANAGERS & RUNTIMES
# ============================================
brew "fnm"                      # Fast Node Manager (Rust-based, nvm alternative)
brew "uv"                       # Python version manager

# ============================================
# CONTAINERS & ORCHESTRATION
# ============================================
brew "docker"                   # Docker CLI
brew "docker-compose"           # Docker Compose tool
brew "colima"                   # Lightweight Docker runtime (replaces Docker Desktop)
brew "kubectl"                  # Kubernetes CLI
brew "k3d"                      # Lightweight local Kubernetes
brew "helm"                     # Kubernetes package manager


# ============================================
# INFRASTRUCTURE & DEVOPS
# ============================================
brew "terraform"                # Infrastructure as Code
brew "azure-cli"                # Azure Command Line Interface

# ============================================
# GUI APPLICATIONS - Browsers
# ============================================
cask "google-chrome"            # Web browser
cask "brave-browser"            # Privacy + crypto browser


# ============================================
# GUI APPLICATIONS - Development
# ============================================
cask "visual-studio-code"       # Code editor
cask "iterm2"                   # Terminal emulator
cask "postman"                  # API development/testing
cask "insomnia"                 # Alternative to Postman


# ============================================
# GUI APPLICATIONS - Productivity
# ============================================
cask "raycast"                  # Productivity launcher
cask "notion"                   # Workspace/notes
cask "rectangle"                # Window management


# ============================================
# GUI APPLICATIONS - Design & Media
# ============================================
cask "figma"                    # Design tool


# ============================================
# GUI APPLICATIONS - Utilities
# ============================================
cask "appcleaner"               # Properly uninstall apps
cask "the-unarchiver"           # Extract any archive format


# ============================================
# FONTS
# ============================================
cask "font-jetbrains-mono-nerd-font"    # Coding font with icons
cask "font-fira-code-nerd-font"         # Alternative coding font

# ============================================
# MAC APP STORE APPS
# ============================================
